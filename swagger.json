  "info": {
    "title": "spandavidya API",
    "description": "API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "name@company.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "GoogleLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "example": "eyJhbGciOiJSUzI1NiIsImtpZCI6...",
            "description": "The idToken from Google Sign-In on the client side"
          },
          "providerAccessToken": {
            "type": "string",
            "description": "Optional Google Access Token for calling Google APIs"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "MobileLogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token issued to the mobile client"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token issued at login"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "password": {
            "type": "string",
            "example": "StrongPassword123",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "password": {
            "type": "string",
            "example": "StrongPassword123",
            "minLength": 6
          },
          "avatarUrl": {
            "type": "string",
            "example": "Software Engineer"
          }
        },
        "required": [
          "avatarUrl"
        ]
      },
      "PresignedUrlDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "example": "document.pdf",
            "description": "The name of the file to upload"
          },
          "fileType": {
            "type": "string",
            "example": "application/pdf",
            "description": "The MIME type of the file"
          },
          "fileSize": {
            "type": "number",
            "example": 102400,
            "description": "The size of the file in bytes"
          }
        },
        "required": [
          "fileName",
          "fileType",
          "fileSize"
        ]
      },
      "QueryAuditDto": {
        "type": "object",
        "properties": {}
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "description": "HTTP status code of the response",
            "example": 400
          },
          "errorCode": {
            "type": "string",
            "description": "Machine-readable error code for client pipeline resolution",
            "enum": [
              "EYE_NOT_DETECTED",
              "INVALID_IMAGE",
              "UNSUPPORTED_FORMAT",
              "IMAGE_TOO_LARGE",
              "IMAGE_RESOLUTION_TOO_HIGH",
              "MODEL_LOADING",
              "MODEL_TIMEOUT",
              "AI_SERVICE_UNAVAILABLE",
              "PREDICTION_FAILED",
              "UPLOAD_FAILED",
              "NO_INTERNET",
              "NETWORK_ERROR",
              "DATABASE_UNAVAILABLE",
              "UNAUTHORIZED",
              "ANALYSIS_FAILED",
              "VALIDATION_ERROR",
              "INVALID_CREDENTIALS",
              "FORBIDDEN",
              "USER_NOT_FOUND",
              "EMAIL_ALREADY_EXISTS",
              "OTP_INVALID",
              "OTP_EXPIRED",
              "OTP_RATE_LIMITED",
              "CHAT_NOT_FOUND"
            ],
            "example": "INVALID_IMAGE"
          },
          "category": {
            "type": "string",
            "description": "High-level functional category of the error",
            "enum": [
              "IMAGE",
              "AI",
              "NETWORK",
              "AUTH",
              "DATABASE",
              "SYSTEM",
              "STORAGE",
              "VALIDATION",
              "CONFIG"
            ],
            "example": "IMAGE"
          },
          "message": {
            "type": "object",
            "description": "Human-readable error message or list of validation messages",
            "example": "Invalid image file format"
          },
          "error": {
            "type": "string",
            "description": "Standard HTTP error name",
            "example": "Bad Request"
          },
          "requestId": {
            "type": "string",
            "description": "Unique request correlation tracking identifier",
            "example": "req-c1a2b3c4-5678"
          },
          "timestamp": {
            "type": "string",
            "description": "ISO-8601 UTC timestamp when error occurred",
            "example": "2026-08-06T09:30:00.000Z"
          },
          "contractVersion": {
            "type": "string",
            "description": "Machine error contract version string",
            "example": "1.0"
          }
        },
        "required": [
          "statusCode",
          "message",
          "requestId",
          "timestamp",
          "contractVersion"
        ]
      },
      "SendMessageDto": {
        "type": "object",
        "properties": {}
      },
      "StreamMessageDto": {
        "type": "object",
        "properties": {}
