# Required
# Backend base URL (NestJS API gateway)
# Local dev example (Android uses 10.0.2.2, iOS uses localhost):
EXPO_PUBLIC_API_URL=http://localhost:8080/v1

# Google Sign-In Web client ID (used by web auth-session and native GoogleSignin.configure)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
