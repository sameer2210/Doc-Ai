generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  password             String?
  name                 String?
  avatarUrl            String?
  googleId             String?            @unique
  role                 Role               @default(USER)
  hashedRefreshToken   String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  bodyInsightCompleted Boolean            @default(false)
  predictions          AiPrediction[]
  auditLogs            AuditLog[]
  bodyInsight          BodyInsight?
  chats                Chat[]
  sessions             Session[]
  uploads              Upload[]
  authProviders        UserAuthProvider[]

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model Chat {
  id        String    @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([updatedAt])
}

model Message {
  id         String        @id @default(uuid())
  chatId     String
  role       SenderRole
  content    String?
  tokenCount Int?
  metadata   Json?
  createdAt  DateTime      @default(now())
  prediction AiPrediction?
  chat       Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  uploads    Upload[]

  @@index([chatId])
  @@index([chatId, createdAt])
  @@index([createdAt])
}

model Upload {
  id         String        @id @default(uuid())
  userId     String
  messageId  String?
  fileUrl    String
  fileType   String
  mimeType   String?
  fileSize   Int?
  s3Key      String        @unique
  createdAt  DateTime      @default(now())
  prediction AiPrediction?
  message    Message?      @relation(fields: [messageId], references: [id])
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([messageId])
}

model AiPrediction {
  id              String   @id @default(uuid())
  userId          String
  messageId       String   @unique
  uploadId        String   @unique
  prediction      String
  confidence      Float
  clinicalSummary String?
  recommendation  String?
  rawMlResponse   Json
  aiProvider      String   @default("GOOGLE_CLOUD_RUN")
  modelVersion    String   @default("v1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  upload          Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  context   String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([context])
}

model BodyInsight {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  dateOfBirth             DateTime?
  gender                  Gender?
  diabetes                Boolean
  hypertension            Boolean
  blurredVision           Boolean
  nightVisionDifficulty   Boolean
  halosAroundLights       Boolean
  familyHistoryOfCataract Boolean
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAuthProvider {
  id        String       @id @default(uuid())
  userId    String
  provider  AuthProvider
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([email])
  @@index([expiresAt])
}

model EmailOtpRateLimit {
  email         String    @id
  dailyCount    Int       @default(0)
  lastResetAt   DateTime
  lastRequestAt DateTime?
}

enum Role {
  USER
  ADMIN
  MODERATOR
  DOCTOR
}

enum SenderRole {
  USER
  ASSISTANT
  SYSTEM
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AuthProvider {
  GOOGLE
  EMAIL_OTP
}
